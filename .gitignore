# ---- Python -------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/

# ---- Tooling caches -----------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ipynb_checkpoints/

# ---- Secrets and env ----------------------------------------
# .env.example IS committed. Everything else is not.
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/
aws/
secrets/

# ---- Terraform ----------------------------------------------
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.hcl
*.tf

!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json

# ---- Models and weights -------------------------------------
*.pth
*.pt
*.safetensors
*.gguf
models/
checkpoints/

# ---- Data and indexes ---------------------------------------
data/
data/raw/
data/interim/
# but DO commit the eval set, baseline, index, and eval runs (portfolio + build needs them)
!data/evalset.jsonl
!data/eval_baseline.json
!data/index.json
!data/index_version.txt
!data/eval_runs/
!data/eval_runs/**
*.faiss
*.duckdb
*.sqlite
*.sqlite3

# ---- Eval + run artifacts -----------------------------------
# cassettes/ is intentionally NOT ignored — they are test fixtures
# and your evals are not reproducible without them.
evals/reports/
evals/runs/
traces/
logs/
*.log

# ---- Local infra volumes ------------------------------------
.docker/
pgdata/
redisdata/
langfuse-data/

# ---- Editors and OS -----------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- Misc ---------------------------------------------------
*.zip
