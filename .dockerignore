# Python cruft
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# Virtual env (the image builds its own)
.venv/
venv/

# Local runtime data that shouldn't ship
data/sessions/
data/audit.jsonl

# Secrets — never bake these into an image
.env
*.env
.streamlit/secrets.toml

# Git and OS noise
.git/
.DS_Store
